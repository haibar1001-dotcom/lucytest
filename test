	-- MapEggs_Standalone-compatible key lookup. Some servers expose the egg
	-- UUID as an attribute or ActiveEggs entry instead of using Instance.Name.
	tbl3.EggPickupKeys = function(egg, eggPosition)
		local keys, seen = {}, {}
		local keyNames = { "EggKey", "EggId", "UUID", "Id", "ID", "Key" }
		local function valid(value)
			if type(value) ~= "string" then return nil end
			value = value:gsub("^%s+", ""):gsub("%s+$", "")
			if value == "" or #value < 8 or value:find("%s") then return nil end
			return value
		end
		local function add(value)
			value = valid(value)
			if value and not seen[value] then
				seen[value] = true
				keys[#keys + 1] = value
			end
		end
		local function firstKey(target)
			if not target then return nil end
			for _, keyName in ipairs(keyNames) do
				local value = valid(target:GetAttribute(keyName))
				if value then return value end
				local child = target:FindFirstChild(keyName, true)
				if child and child:IsA("StringValue") then
					value = valid(child.Value)
					if value then return value end
				end
			end
			for _, value in pairs(target:GetAttributes()) do
				value = valid(value)
				if value then return value end
			end
			return valid(target.Name)
		end
		if activeEggs and typeof(eggPosition) == "Vector3" then
			for _, entry in ipairs(activeEggs:GetChildren()) do
				local position = entry:GetAttribute("Position")
				local part = entry:IsA("BasePart") and entry or entry:FindFirstChildWhichIsA("BasePart", true)
				if typeof(position) ~= "Vector3" and part then position = part.Position end
				if typeof(position) == "Vector3" and (position - eggPosition).Magnitude <= 12 then
					add(valid(entry.Name) or firstKey(entry))
				end
			end
		end
		if #keys == 0 then add(firstKey(egg)) end
		return keys
	end
	tbl3.FireEggPickup = function(egg, eggPosition)
		local root = tbl3.Root()
		if not root or typeof(eggPosition) ~= "Vector3" or (root.Position - eggPosition).Magnitude > 80 then
