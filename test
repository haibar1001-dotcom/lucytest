-- Ethereal collection webhook.  This is intentionally isolated from the farm
-- loop so a failed request can never stop egg collection.
local etherealWebhook = {
	Enabled = false,
	Url = "",
	LastSent = {},
}

local function getWebhookRequest()
	local env = type(getgenv) == "function" and getgenv() or _G
	if type(env) == "table" then
		if type(env.request) == "function" then return env.request end
		if type(env.http_request) == "function" then return env.http_request end
		if type(env.syn) == "table" and type(env.syn.request) == "function" then return env.syn.request end
		if type(env.http) == "table" and type(env.http.request) == "function" then return env.http.request end
	end
	if type(request) == "function" then return request end
	if type(http_request) == "function" then return http_request end
	if type(syn) == "table" and type(syn.request) == "function" then return syn.request end
	if type(fluxus) == "table" and type(fluxus.request) == "function" then return fluxus.request end
	if type(http) == "table" and type(http.request) == "function" then return http.request end
	if HttpService and type(HttpService.RequestAsync) == "function" then
		return function(options)
			return HttpService:RequestAsync(options)
		end
	end
	return nil
end

local function webhookImageUrl(image)
	local value = tostring(image or "")
	if value:match("^https?://") then return value end
	local assetId = value:match("%d+")
	if assetId then
		return "https://www.roblox.com/asset-thumbnail/image?assetId=" .. assetId .. "&width=420&height=420&format=png"
	end
	return nil
end

local function webhookInventoryText()
	local counts = {}
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	local character = localPlayer.Character
	local basket = localPlayer:FindFirstChild("Basket")
	local function scan(container)
		if not container then return end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and tbl3.EggData(item.Name) then
				counts[item.Name] = (counts[item.Name] or 0) + 1
			end
		end
	end
	scan(backpack)
	scan(character)
	if basket then
		for _, item in ipairs(basket:GetChildren()) do
			local eggName = item:GetAttribute("Egg") or item.Name
			if tbl3.EggData(eggName) then counts[tostring(eggName)] = (counts[tostring(eggName)] or 0) + 1 end
		end
	end
	local rows = {}
	for name, count in pairs(counts) do rows[#rows + 1] = {Name = name, Count = count} end
	table.sort(rows, function(a, b) return a.Name < b.Name end)
	local text = {}
	for i = 1, math.min(#rows, 12) do text[#text + 1] = rows[i].Name .. " × " .. rows[i].Count end
	return #text > 0 and table.concat(text, "\n") or "No egg tools"
end

tbl3.SendEtherealWebhook = function(egg, eggName, force)
	if not etherealWebhook.Enabled or etherealWebhook.Url == "" then return false end
	if not etherealWebhook.Url:match("discord%.com/api/webhooks/") and not etherealWebhook.Url:match("discordapp%.com/api/webhooks/") then return false end
	if not force and tostring(tbl3.EggRarity(eggName)):lower() ~= "ethereal" then return false end
	local key = egg and egg:GetDebugId() or tostring(eggName)
	local now = os.clock()
	if etherealWebhook.LastSent[key] and now - etherealWebhook.LastSent[key] < 4 then return false end
	local send = getWebhookRequest()
	if not send then return false end

	local data = tbl3.EggData(eggName) or {}
	local odds = tbl3.PetOdds(eggName)
	local oddsLines = {}
	for i = 1, math.min(#odds, 12) do
		oddsLines[#oddsLines + 1] = string.format("**%s** — %.2f%%", odds[i].Name, odds[i].Chance)
	end
	if #oddsLines == 0 then oddsLines[1] = "No hatch odds data" end

	local character = localPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local position = root and root.Position
	local playerName = localPlayer.DisplayName ~= "" and localPlayer.DisplayName or localPlayer.Name
	local playerField = string.format("**%s** (@%s)\nUserId: `%s`\nCash: `%s`", playerName, localPlayer.Name, tostring(localPlayer.UserId), tostring(tbl3.Cash()))
	local basketField = string.format("Basket: `%d / %d`\nEgg tools:\n%s", tbl3.BasketCount(), tbl3.BasketCapacity(), webhookInventoryText())
	local serverField = string.format("PlaceId: `%s`\nJobId: `%s`\nPosition: `%s`", tostring(game.PlaceId), tostring(game.JobId), position and string.format("%.0f, %.0f, %.0f", position.X, position.Y, position.Z) or "unknown")
	local embed = {
		Title = "🥚 Ethereal Egg Collected",
		Description = string.format("**%s** collected successfully.", tostring(eggName)),
		Color = 0x8D5CFF,
		Fields = {
			{Name = "🐾 Hatch odds", Value = table.concat(oddsLines, "\n"), Inline = false},
			{Name = "👤 Player", Value = playerField, Inline = true},
			{Name = "🎒 Basket / inventory", Value = basketField, Inline = true},
			{Name = "🌐 Server", Value = serverField, Inline = false},
		},
		Footer = {Text = "Lucy Hub • Ethereal collection log"},
		Timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
	}
	local image = webhookImageUrl(data.Image)
	if image then embed.Thumbnail = {url = image} end
	local payload = {
		username = "Lucy Hub • Egg Log",
		allowed_mentions = {parse = {}},
		embeds = {embed},
	}
	local callOk, response = pcall(send, {
		Url = etherealWebhook.Url,
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = HttpService:JSONEncode(payload),
	})
	local status = type(response) == "table" and tonumber(response.StatusCode or response.Status) or nil
	local success = callOk and (type(response) ~= "table" or response.Success ~= false) and (not status or (status >= 200 and status < 300))
	if success then etherealWebhook.LastSent[key] = now end
	return success
end

