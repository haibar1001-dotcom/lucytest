	if env.LucyHubCoreLogoGuard then pcall(function() env.LucyHubCoreLogoGuard:Disconnect() end) end
	env.LucyHubLogoGuard = PlayerGui.DescendantAdded:Connect(removeOrphanLucyLogo)
	for _, item in ipairs(PlayerGui:GetDescendants()) do removeOrphanLucyLogo(item) end
	local coreGui = game:GetService("CoreGui")
	env.LucyHubCoreLogoGuard = coreGui.DescendantAdded:Connect(removeOrphanLucyLogo)
