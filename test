		if type(loader) ~= "function" then return false, "loadstring unavailable" end
		local ok, source = pcall(function() return game:HttpGet(MAP_EGG_REMOTE_URL) end)
		if not ok or type(source) ~= "string" or source == "" then return false, tostring(source) end
		local compiled, chunk = pcall(loader, source)
		if not compiled or type(chunk) ~= "function" then return false, tostring(chunk) end
		local ran, err = pcall(chunk)
