local function SetUILanguage(language)
	UILanguage = language == "Thai" and "Thai" or "English"
	local dictionary = UILanguage == "Thai" and ThaiText or nil
	local roots = {}
	if index3.Holder and index3.Holder.Instance then roots[#roots + 1] = index3.Holder.Instance end
	if index3.UnusedHolder and index3.UnusedHolder.Instance then roots[#roots + 1] = index3.UnusedHolder.Instance end
	if #roots == 0 then return end
	for _, root in ipairs(roots) do
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("TextLabel") or item:IsA("TextButton") then
				local original = item:GetAttribute("RideAPetOriginalText")
				if original == nil then original = item.Text; item:SetAttribute("RideAPetOriginalText", original) end
				item.Text = dictionary and (dictionary[original] or dictionary[item.Text] or original) or original
			elseif item:IsA("TextBox") then
				local original = item:GetAttribute("RideAPetOriginalPlaceholder")
				if original == nil then original = item.PlaceholderText; item:SetAttribute("RideAPetOriginalPlaceholder", original) end
				item.PlaceholderText = dictionary and (dictionary[original] or dictionary[item.PlaceholderText] or original) or original
			end
		end
	end
	-- Thai glyphs need more room than the compact English layout.
	for _, root in ipairs(roots) do
	for _, item in ipairs(root:GetDescendants()) do
		if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
			local base = item:GetAttribute("RideAPetBaseTextSize")
			if base == nil then base = item.TextSize; item:SetAttribute("RideAPetBaseTextSize", base) end
			item.FontFace = index3.Font
			local scale = UILanguage == "Thai" and 1.28 or 1.18
			item.TextSize = math.max(base + 2, math.floor(base * scale))
		end
	end
	end
end
