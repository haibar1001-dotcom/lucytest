-- Remove orphaned Map Egg/logo GUIs left by an earlier execution. The main
-- LucyHub ScreenGui is deliberately excluded because its dark circle is the
-- only launcher that should remain.
pcall(function()
	local roots = { uiParent, PlayerGui }
	pcall(function() roots[#roots + 1] = game:GetService("CoreGui") end)
	for _, root in ipairs(roots) do
		if typeof(root) == "Instance" then
			for _, child in ipairs(root:GetChildren()) do
				local lowerName = child.Name:lower()
				local staleMapName = root.Name ~= "CoreGui" and (lowerName == "settingshub" or lowerName:find("mapegg", 1, true) or lowerName:find("map_egg", 1, true))
				if isLucyLogoGui(child) or staleMapName or (child:IsA("ScreenGui") and child.Name == "LucyHub" and not isMainLucyHub(child)) then child:Destroy() end
			end
		end
	end
end)

-- A script re-execution must replace the previous LucyHub instance. Leaving an
-- old ScreenGui alive is what produces a second floating Lucy logo.
pcall(function()
	local roots, seen = {}, {}
	local function addRoot(root)
		if typeof(root) == "Instance" and not seen[root] then
			seen[root] = true
			roots[#roots + 1] = root
		end
	end
	addRoot(uiParent)
	addRoot(PlayerGui)
	pcall(function() addRoot(game:GetService("CoreGui")) end)
	for _, uiRoot in ipairs(roots) do
		for _, child in ipairs(uiRoot:GetChildren()) do
			if child:IsA("ScreenGui") and child.Name == "LucyHub" then
				child:Destroy()
			end
		end
	end
end)

