	-- Uses the game's HatchLuck module when available, so the ESP shows the
	-- actual weighted hatch chance instead of guessing from pet rarity.
	tbl3.PetOdds = function(eggName)
		local eggData = tbl3.EggData(eggName)
		local hatchLuck = tbl.HatchLuck
		if type(eggData) ~= "table" then return {} end
		local odds = nil
		local usingFallback = false
		if type(hatchLuck) == "table" and type(hatchLuck.GetOdds) == "function" then
			local ok, result = pcall(hatchLuck.GetOdds, tonumber(eggData.Luck) or 1, eggData)
			if ok and type(result) == "table" then odds = result end
		end
		local result = {}
		if type(odds) ~= "table" or #odds == 0 then
			usingFallback = true
			-- Fallback for executors that cannot require HatchLuck. Pool sample
			-- sizes still provide a useful normalized chance for the ESP.
			local pool = type(eggData.PoolLuck) == "table" and eggData.PoolLuck.Pets or nil
			for _, name in ipairs(eggData.Pets or {}) do
				local config = pool and pool[name]
				local sample = config and tonumber(config.SampleSize)
				if sample and sample > 0 then
					odds = odds or {}
					odds[#odds + 1] = { PetName = name, Chance = 1 / sample }
				end
			end
		end
		local total = 0
		for _, entry in ipairs(odds or {}) do total += tonumber(entry.Chance or entry.Weight) or 0 end
		for _, entry in ipairs(odds or {}) do
			local name = tostring(entry.PetName or entry.Name or "")
			local chance = tonumber(entry.Chance or entry.Weight) or 0
			if usingFallback and total > 0 then chance = chance / total end
			local petData = type(tbl.Pets) == "table" and tbl.Pets[name] or nil
			if name ~= "" and chance > 0 then
				if chance <= 1 then chance *= 100 end
				result[#result + 1] = {
					Name = name,
					Chance = math.clamp(chance, 0, 100),
					Image = type(petData) == "table" and tostring(petData.Image or "") or "",
				}
			end
		end
		table.sort(result, function(a, b) return a.Chance > b.Chance end)
		return result
	end

