local function isMainLucyHub(gui)
	if typeof(gui) ~= "Instance" or not gui:IsA("ScreenGui") or gui.Name ~= "LucyHub" then return false end
	for _, item in ipairs(gui:GetDescendants()) do
		if (item:IsA("TextLabel") or item:IsA("TextButton")) and tostring(item.Text):find("Ride A Pet", 1, true) then
			return true
		end
	end
	return false
end

local function isLucyLogoGui(gui)
	if typeof(gui) ~= "Instance" or not gui:IsA("ScreenGui") or isMainLucyHub(gui) then
		return false
	end
	for _, item in ipairs(gui:GetDescendants()) do
		if (item:IsA("ImageLabel") or item:IsA("ImageButton")) and tostring(item.Image):find("136613723442373", 1, true) then
			return true
		end
	end
	return false
end

local function isLucyLogoImage(item)
	return typeof(item) == "Instance" and (item:IsA("ImageLabel") or item:IsA("ImageButton"))
		and tostring(item.Image):find("136613723442373", 1, true) ~= nil
end

local function removeOrphanLucyLogo(item)
	if not isLucyLogoImage(item) then return end
	local screenGui = item:FindFirstAncestorOfClass("ScreenGui")
	if screenGui and isMainLucyHub(screenGui) then return end
	if screenGui and screenGui.Name == "RobloxGui" then return end
	-- Remove only the logo node. The map window, if it shares the same GUI,
	-- remains usable while its separate floating launcher disappears.
	pcall(function() item:Destroy() end)
end

pcall(function()
	local env = type(getgenv) == "function" and getgenv() or _G
