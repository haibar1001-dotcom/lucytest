		if #guis == 0 then return false end
		local hasVisibleWindow = false
		for _, gui in ipairs(guis) do
			for _, item in ipairs(gui:GetChildren()) do
				if item:IsA("GuiObject") then
					local width = math.abs(item.Size.X.Offset)
					local height = math.abs(item.Size.Y.Offset)
					if width >= 280 and height >= 280 and item.Visible then
						hasVisibleWindow = true
					end
				end
			end
		end
		local env = type(getgenv) == "function" and getgenv() or _G
		local tracker = env and env.MapEggsTracker
		if not hasVisibleWindow and not mapEggWindowOpened and type(tracker) == "table" and type(tracker.Toggle) == "function" then
			local toggled = pcall(tracker.Toggle)
			if toggled then mapEggWindowOpened = true end
		elseif not hasVisibleWindow and not mapEggWindowOpened then
			return false
		else
			mapEggWindowOpened = mapEggWindowOpened or hasVisibleWindow
		end
		-- The tracker window is the large direct child. Every small direct child is
		-- its separate launcher, so hiding those cannot hide the egg cards window.
		for _, gui in ipairs(guis) do
			for _, item in ipairs(gui:GetChildren()) do
				if item:IsA("GuiObject") then
					local width = math.abs(item.Size.X.Offset)
					local height = math.abs(item.Size.Y.Offset)
