local function T(value)
	value = tostring(value or "")
	if UILanguage ~= "Thai" then return value end
	if ThaiText[value] then return ThaiText[value] end
	local prefix, name = value:match("^(Collecting) (.+)$")
	if prefix then return "กำลังเก็บ " .. name end
	prefix, name = value:match("^(Planting) (.+)$")
	if prefix then return "กำลังปลูก " .. name end
	prefix, name = value:match("^(Placing) (.+)$")
	if prefix then return "กำลังวาง " .. name end
	prefix, name = value:match("^(Feeding) (.+)$")
	if prefix then return "กำลังให้อาหาร " .. name end
	return value
end
