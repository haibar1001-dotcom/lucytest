	-- Streaming preparation: request the map around known farm regions in the
	-- background and preload already-replicated assets in small batches.
	tbl3.Streaming = { Ready = false, Running = false, Requested = {} }
	tbl3.StreamAt = function(position)
		if typeof(position) ~= "Vector3" then return false end
		local key = string.format("%d:%d:%d", math.floor(position.X / 128), math.floor(position.Y / 128), math.floor(position.Z / 128))
		if tbl3.Streaming.Requested[key] then return true end
		tbl3.Streaming.Requested[key] = true
		if workspace.StreamingEnabled and type(localPlayer.RequestStreamAroundAsync) == "function" then
			local ok = pcall(function()
				localPlayer:RequestStreamAroundAsync(position)
			end)
			return ok
		end
		return true
	end
	tbl3.PreloadMap = function()
		if tbl3.Streaming.Running or tbl3.Streaming.Ready then return end
		tbl3.Streaming.Running = true
		tbl3.Status = "Loading map"
		local points, cells = {}, {}
		local function addPoint(position)
			if typeof(position) ~= "Vector3" then return end
			local key = string.format("%d:%d:%d", math.floor(position.X / 512), math.floor(position.Y / 512), math.floor(position.Z / 512))
			if not cells[key] then cells[key] = true; points[#points + 1] = position end
		end
		local root = tbl3.Root()
		addPoint(root and root.Position)
		addPoint(tbl3.PlotTop())
		addPoint(Vector3.new(-5033, 41272, -3545))
		local volcano = workspace:FindFirstChild("Volcano")
		local volcanoTop = volcano and volcano:FindFirstChild("VolcanoTop", true)
		addPoint(volcanoTop and volcanoTop:IsA("BasePart") and volcanoTop.Position)
		for _, descendant in ipairs(workspace:GetDescendants()) do
			if descendant:IsA("BasePart") then
				addPoint(descendant.Position)
				if #points >= 64 then break end
			end
		end
		for _, position in ipairs(points) do
			tbl3.StreamAt(position)
			task.wait(0.04)
		end
		local assets, batch = {}, {}
		for _, descendant in ipairs(workspace:GetDescendants()) do
			-- Geometry and surface assets are enough to warm the map. Audio is
			-- intentionally excluded so startup does not create extra bandwidth.
			if descendant:IsA("MeshPart") or descendant:IsA("UnionOperation") or descendant:IsA("Decal") or descendant:IsA("Texture") then
				batch[#batch + 1] = descendant
				if #batch >= 80 then
					assets[#assets + 1] = batch
					batch = {}
				end
			end
		end
		if #batch > 0 then assets[#assets + 1] = batch end
		for _, group in ipairs(assets) do
			pcall(function() ContentProvider:PreloadAsync(group) end)
			task.wait()
		end
		tbl3.Streaming.Ready = true
		tbl3.Streaming.Running = false
		tbl3.Status = "Idle"
	end
	task.spawn(function()
		pcall(tbl3.PreloadMap)
		if tbl3.Streaming.Running then tbl3.Streaming.Running = false end
	end)

